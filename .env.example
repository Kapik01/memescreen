# Copy to .env and fill in. .env is gitignored.
# Birdeye free API key: https://bds.birdeye.so  (holder data; scanner needs it
# for the holder-growth filter -- without it every hit fails that check)
BIRDEYE_API_KEY=
# Helius free API key: https://dashboard.helius.dev  (metadata fallback; optional)
HELIUS_API_KEY=
# Discord channel webhook for scan alerts (tokens that PASS the gate). Channel
# -> Edit -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# Blank = alerts print + go to <DATA_DIR>/missed_alerts.log instead.
DISCORD_WEBHOOK_URL=
# Optional: a second webhook -> a #scan-rejects channel. Every detected spike
# the gate filtered out is posted there with the reason. This same channel
# also receives the NEW PUMP momentum alerts below. Blank = neither is posted.
DISCORD_REJECTS_WEBHOOK_URL=

# --- NEW PUMP momentum alert (young token already running; -> rejects channel,
# no safety gate, labelled unvetted). All optional; shown with their defaults.
# PUMP_PRICE_PCT=20         # min 1h price change, percent
# PUMP_MIN_AGE_H=1          # pair must be at least this many hours old
# PUMP_MAX_AGE_H=24         # ...and no older than this
# PUMP_MIN_LIQUIDITY=10000  # min liquidity, USD
# PUMP_MAX_TOP10_PCT=30     # top-10 holders must own <= this percent of supply
# PUMP_COOLDOWN_H=3         # at most one NEW PUMP alert per token per this many hours
# Where the scanner keeps its SQLite db + logs. Default "data". On Railway set
# this to the mount path of a persistent volume, e.g. /data
DATA_DIR=
