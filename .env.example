# Copy to .env and fill in. .env is gitignored.
# Birdeye free API key: https://bds.birdeye.so  (holder data; scanner needs it
# for the holder-growth filter -- without it every hit fails that check)
BIRDEYE_API_KEY=
# Helius free API key: https://dashboard.helius.dev  (metadata fallback; optional)
HELIUS_API_KEY=
# Discord channel webhook for scan alerts. Channel -> Edit -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL. Blank = alerts print + go to
# <DATA_DIR>/missed_alerts.log instead.
DISCORD_WEBHOOK_URL=
# Where the scanner keeps its SQLite db + logs. Default "data". On Railway set
# this to the mount path of a persistent volume, e.g. /data
DATA_DIR=
